# ====================================================================
# QueueLess Rural - Environment Variables & AWS Infrastructure Config
# ====================================================================
# Copy this file to .env and replace placeholders with your actual AWS details.

# 1. AWS Global Settings
VITE_AWS_REGION=ap-south-1
VITE_USE_MOCK_BACKEND=false

# 2. AWS Cognito Authentication (User Pool)
# Create a User Pool in ap-south-1 with:
# - Sign-in attribute: phone_number OR email
# - Groups: 'Patients' and 'Admins' / 'HospitalStaff'
VITE_COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_IDENTITY_POOL_ID=ap-south-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 3. Amazon DynamoDB Tables
# Create the following DynamoDB tables with Partition Keys (PK) & Sort Keys (SK):
VITE_DYNAMO_PATIENTS_TABLE=QueueLess_Patients
VITE_DYNAMO_STAFF_TABLE=QueueLess_Staff
VITE_DYNAMO_DOCTORS_TABLE=QueueLess_Doctors
VITE_DYNAMO_CLINICS_TABLE=QueueLess_Clinics
VITE_DYNAMO_APPOINTMENTS_TABLE=QueueLess_Appointments
VITE_DYNAMO_QUEUES_TABLE=QueueLess_Queues

# 4. API Gateway / AppSync / Lambda Base URL
VITE_API_GATEWAY_URL=https://api.queless-rural.health.org/v1
