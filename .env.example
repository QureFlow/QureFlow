# ====================================================================
# QureFlow - Frontend Environment Variables (.env)
# ====================================================================
# Copy this file to .env in the project root:

# 1. AWS Region
VITE_AWS_REGION=eu-north-1

# 2. Toggle Backend Mode
# Set to false to use live backend and DynamoDB / Cognito.
# Set to true to use offline browser mock storage.
VITE_USE_MOCK_BACKEND=false

# 3. DynamoDB Table Name
VITE_DYNAMODB_TABLE_NAME=QureFlow

# 4. Backend API Base URL
VITE_API_GATEWAY_URL=http://localhost:5000/api

# 5. Amazon Cognito Authentication (Optional)
COGNITO_USER_POOL_ID=eu-north-1_ifvgZav0V
COGNITO_CLIENT_ID=8kjcdr3nasamp0t8h04ekrvnb
COGNITO_CLIENT_SECRET=your_client_secret_here
