AWS_REGION=eu-north-1
DYNAMODB_TABLE_NAME=QureFlow
AUTH_PROVIDER=cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Backend-only, if your Cognito app client has a secret:
COGNITO_CLIENT_SECRET=
# Generate a unique random secret of at least 32 characters; never use demo credentials.
JWT_SECRET=
PORT=5000
CORS_ORIGINS=http://localhost:5180,http://localhost:5000
# Set only when the deployment has a known, fixed trusted proxy chain:
# TRUST_PROXY_HOPS=1
# Leave unset for real AWS. Local demo/test entry points set this themselves.
# DYNAMODB_ENDPOINT=http://127.0.0.1:18000
# Prefer an AWS workload IAM role or your AWS CLI profile; do not commit AWS keys.
