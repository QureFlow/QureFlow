# ====================================================================
# QureFlow - Backend Environment Variables (backend/.env)
# ====================================================================
# Copy this file to backend/.env:

AWS_REGION=eu-north-1
DYNAMODB_TABLE_NAME=QureFlow
PORT=5000
JWT_SECRET=qureflow-jwt-secret-key-production-ready-2026

# AWS Credentials (if not using ~/.aws/credentials or IAM Role)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Amazon Cognito User Pool Authentication
COGNITO_USER_POOL_ID=eu-north-1_ifvgZav0V
COGNITO_CLIENT_ID=8kjcdr3nasamp0t8h04ekrvnb
COGNITO_CLIENT_SECRET=your_client_secret_here
