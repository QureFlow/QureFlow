{
  "name": "qureflow-backend",
  "version": "1.0.0",
  "description": "QureFlow API: clinic queues, bookings and waiting-time estimates on Amazon DynamoDB and Cognito",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:demo": "tsx watch src/demoServer.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "migrate:backfill": "tsx src/migrations/backfillIndexes.ts",
    "verify:aws": "tsx src/verifyAws.ts",
    "verify:demo": "tsx src/demo/verifyDataset.ts",
    "demo:reset": "tsx src/demo/resetLocalDemo.ts",
    "evaluate:model": "tsx src/evaluation/evaluateWaitModel.ts",
    "test": "tsx tests/backend.test.ts",
    "test:discovery": "tsx --test tests/discovery.test.ts tests/localDiscovery.test.ts"
  },
  "keywords": [
    "healthcare",
    "queue",
    "aws",
    "dynamodb",
    "cognito"
  ],
  "author": "QureFlow Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1131.0",
    "@aws-sdk/client-dynamodb": "^3.714.0",
    "@aws-sdk/lib-dynamodb": "^3.714.0",
    "aws-jwt-verify": "^5.2.1",
    "bcryptjs": "^2.4.3",
    "bonjour-service": "^1.4.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "serverless-http": "^4.0.0",
    "uuid": "^11.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
