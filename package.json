{
  "name": "qureflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev --prefix backend\" \"vite\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "vite",
    "dev:demo": "concurrently -k -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:demo --prefix backend\" \"vite --mode demo\"",
    "build": "tsc && vite build && npm run build --prefix backend",
    "start": "node backend/dist/server.js",
    "test": "npm test --prefix backend",
    "seed": "npm run seed --prefix backend",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.2",
    "vite": "^6.0.1"
  }
}
