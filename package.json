{
  "name": "qureflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"mysql,frontend\" -c \"cyan,magenta\" \"npm run dev:dbms --prefix backend\" \"vite --mode dbms --port 5174 --strictPort\"",
    "dev:backend": "npm run dev:dbms --prefix backend",
    "dev:frontend": "vite --mode dbms --port 5174 --strictPort",
    "dev:demo": "concurrently -k -n \"mysql,frontend\" -c \"cyan,magenta\" \"npm run dev:dbms --prefix backend\" \"vite --mode dbms --port 5174 --strictPort\"",
    "build": "tsc && vite build --mode dbms && npm run build --prefix backend",
    "start": "node backend/dist/mysqlServer.js",
    "test": "npm run test:dbms --prefix backend",
    "test:announcements": "node backend/node_modules/tsx/dist/cli.mjs --test tests/clinicAnnouncements.test.ts",
    "test:mobile": "node --test tests/mobile-connection.test.cjs",
    "test:discovery": "npm run test:discovery --prefix backend",
    "seed": "npm run seed:dbms --prefix backend",
    "preview": "vite preview",
    "dev:aws": "concurrently -k -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:aws --prefix backend\" \"vite\"",
    "dev:demo:aws": "concurrently -k -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:demo --prefix backend\" \"vite --mode demo\"",
    "dev:dbms": "concurrently -k -n \"mysql,frontend\" -c \"cyan,magenta\" \"npm run dev:dbms --prefix backend\" \"vite --mode dbms --port 5174 --strictPort\"",
    "test:aws": "npm run test:aws --prefix backend",
    "test:dbms": "npm run test:dbms --prefix backend",
    "build:aws": "tsc && vite build && npm run build --prefix backend",
    "start:dbms": "node backend/dist/mysqlServer.js",
    "start:aws": "node backend/dist/server.js",
    "seed:aws": "npm run seed:aws --prefix backend",
    "seed:dbms": "npm run seed:dbms --prefix backend",
    "db:up": "docker compose -p qureflow-dbms -f compose.dbms.yaml up -d --wait",
    "db:stop": "docker compose -p qureflow-dbms -f compose.dbms.yaml stop",
    "db:shell": "docker compose -p qureflow-dbms -f compose.dbms.yaml exec mysql mysql -uqureflow -p qureflow_dbms",
    "build:mobile": "tsc && vite build --mode mobile",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:open": "cap open android",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "verify:local": "node scripts/verify-local.mjs",
    "evidence:serve": "node scripts/serve-evidence.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "postcss": "^8.4.49",
    "react-test-renderer": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.2",
    "vite": "^6.0.1"
  }
}
